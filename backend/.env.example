# KickLog 백엔드 환경변수 템플릿 — `cp .env.example .env` 후 값을 채워서 사용한다.
# 운영 환경(EC2)에서는 systemd EnvironmentFile 또는 SSM Parameter Store 로 주입.

# ───── 카카오 (필수) ─────
# REST API 키 — https://developers.kakao.com 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# ───── 옵셔널 (application.yml 에 dev 기본값 존재) ─────
# 운영에서는 반드시 오버라이드 — 특히 JWT_SECRET.
# DB_URL=jdbc:postgresql://localhost:5432/kicklog
# DB_USERNAME=kicklog
# DB_PASSWORD=kicklog
# SERVER_PORT=8080
# JWT_SECRET=
# JWT_ISSUER=kicklog
# JWT_AUDIENCE=kicklog-ios
# JWT_ACCESS_TOKEN_MINUTES=15
# JWT_REFRESH_TOKEN_DAYS=30
# APPLE_CLIENT_ID=com.opixxx.KickLog
# APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# KAKAO_USER_INFO_URL=https://kapi.kakao.com/v2/user/me
# KAKAO_LOCAL_SEARCH_URL=https://dapi.kakao.com/v2/local/search/keyword.json
# KAKAO_LOCAL_CONNECT_TIMEOUT_MILLIS=2000
# KAKAO_LOCAL_READ_TIMEOUT_MILLIS=3000

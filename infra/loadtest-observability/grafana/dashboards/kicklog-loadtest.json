{
  "uid": "kicklog-loadtest",
  "title": "KickLog 부하테스트",
  "description": "k6 가 밖에서 본 결과와 백엔드 안의 자원 상태를 같은 타임라인에 놓는다. 처리량이 꺾이는 순간 어떤 자원이 꽉 찼는지, 그때 CPU 는 한가한지를 한 화면에서 본다.",
  "tags": [
    "kicklog",
    "loadtest"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "2s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "2s",
      "5s",
      "10s",
      "30s"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "config",
        "label": "구성",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "kicklog-prom"
        },
        "query": {
          "query": "label_values(jvm_threads_live_threads, config)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "한눈에",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "id": 2,
      "title": "처리량",
      "description": "k6 가 받아낸 초당 요청 수.",
      "datasource": {
        "type": "prometheus",
        "uid": "kicklog-prom"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "kicklog-prom"
          },
          "expr": "sum(rate(k6_http_reqs_total{config=~\"$config\"}[10s]))",
          "editorMode": "code",
          "range": true
        }
      ]
    },
    {
      "type": "stat",
      "id": 3,
      "title": "버려진 요청",
      "description": "주입률을 따라가지 못해 포기된 초당 반복 수. 0 이 아니면 과부하 구간이다.",
      "datasource": {
        "type": "prometheus",
        "uid": "kicklog-prom"
      },
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "thresholds": {
            "mode": "absolute",

# =============================================
# terraform.tfvars.example
# =============================================
# 이 파일을 복사해서 `terraform.tfvars`로 만들고 실제 값 채워 사용한다.
# `terraform.tfvars`는 .gitignore에 있어 커밋되지 않음.
#
# cp terraform.tfvars.example terraform.tfvars
# vi terraform.tfvars

# ─── AWS ──────────────────────────────────────────────
aws_region   = "ap-northeast-2"
environment  = "prod"

# ─── SSH ──────────────────────────────────────────────
# AWS Console > EC2 > Key Pairs에서 미리 생성한 key 이름
# (PEM 파일은 ~/.ssh/<name>.pem에 저장 + chmod 400)
ssh_key_name = "kicklog-keypair"

# ADR-0009: SSH(22) ingress 토글. 기본 false (SSM Session Manager 만 사용).
# 키 분실/유출 등 fallback 이 필요할 때만 true 로 전환 → terraform apply.
# enable_ssh_inbound = false

# 본인 IP만 SSH 허용 (curl ifconfig.me 로 확인 후 /32 추가).
# enable_ssh_inbound=false 면 이 값은 사용되지 않음.
# allowed_ssh_cidr = "121.140.xxx.xxx/32"

# ─── RDS ──────────────────────────────────────────────
# 16자 이상 강한 비밀번호 (특수문자 일부 제한 — / @ " 사용 불가)
rds_password = "REPLACE_ME_with_strong_password_16chars+"

# ─── Application Secrets ──────────────────────────────
# 카카오 디벨로퍼 콘솔 (https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
kakao_rest_api_key = "REPLACE_ME_kakao_rest_api_key"

# JWT 서명용 (32자 이상 랜덤). 예: openssl rand -base64 32
jwt_secret = "REPLACE_ME_jwt_secret_32chars_or_more"

# GHCR private package pull 용 PAT (read:packages 권한, ADR-0008 — CD via SSM)
# GitHub > Settings > Developer settings > PAT (classic) > Generate
ghcr_pat = "REPLACE_ME_ghcr_personal_access_token"

# ─── Observability / Budget (ADR-0009) ────────────────
# Sentry DSN (백엔드 에러 트래킹). 빈 값/미지정이면 secret 미생성 + 앱에서 Sentry 비활성.
# sentry.io > 프로젝트 생성 > Settings > Client Keys (DSN) 에서 발급.
# sentry_dsn = "https://xxxxx@oXXXX.ingest.sentry.io/XXXXXX"

# 운영 알림 수신 이메일. 빈 값으로 두면 SNS email subscription 안 만듦 (SNS topic 자체는 생성됨).
# alert_email = "you@example.com"

# 월 예산 한도 (USD). Free Tier 운영 가정 — 실수 감지용.
# budget_monthly_usd = 5

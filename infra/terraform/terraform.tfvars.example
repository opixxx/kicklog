# =============================================
# terraform.tfvars.example
# =============================================
# 이 파일을 복사해서 `terraform.tfvars`로 만들고 실제 값 채워 사용한다.
# `terraform.tfvars`는 .gitignore에 있어 커밋되지 않음.
#
# cp terraform.tfvars.example terraform.tfvars
# vi terraform.tfvars

# ─── AWS ──────────────────────────────────────────────
aws_region   = "ap-northeast-2"
environment  = "prod"

# ─── SSH ──────────────────────────────────────────────
# AWS Console > EC2 > Key Pairs에서 미리 생성한 key 이름
# (PEM 파일은 ~/.ssh/<name>.pem에 저장 + chmod 400)
ssh_key_name = "kicklog-keypair"

# 본인 IP만 SSH 허용 (curl ifconfig.me 로 확인 후 /32 추가)
allowed_ssh_cidr = "121.140.xxx.xxx/32"

# ─── RDS ──────────────────────────────────────────────
# 16자 이상 강한 비밀번호 (특수문자 일부 제한 — / @ " 사용 불가)
rds_password = "REPLACE_ME_with_strong_password_16chars+"

# ─── Application Secrets ──────────────────────────────
# 카카오 디벨로퍼 콘솔 (https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > REST API 키
kakao_rest_api_key = "REPLACE_ME_kakao_rest_api_key"

# JWT 서명용 (32자 이상 랜덤). 예: openssl rand -base64 32
jwt_secret = "REPLACE_ME_jwt_secret_32chars_or_more"
